# Spotify app credentials (Spotify Developer Dashboard)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Must be registered on the app. Loopback IP literal only (not "localhost").
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Where the OAuth token is cached (auto-created).
# Optional; defaults to ~/.config/spotify-mcp/token.json
SPOTIFY_TOKEN_PATH=
